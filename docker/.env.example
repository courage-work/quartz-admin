# docker compose용 환경변수 예시. `cp docker/.env.example docker/.env` 후 값을 채운다 (.env는 git에 올리지 않음)
# 전체 목록과 기본값은 docs/TRD.md §11.2 참고. QA_DATA_DIR와 PORT는 compose.yaml이 정한다

# 필수: 암호화 키. 아래 명령의 출력값을 넣는다
#   docker run --rm quartz-admin:local node dist/cli.js gen-key
QA_ENCRYPTION_KEYS=
QA_ENCRYPTION_ACTIVE_KEY=k1

# 필수: 브라우저가 접속하는 주소. 리버스 프록시 뒤라면 그 주소(https://...)를 쓴다
QA_PUBLIC_URL=http://localhost:3000
# 리버스 프록시 뒤에서 실행하면 1
# QA_TRUST_PROXY=1

# 최초 기동 시 관리자 계정. users 테이블이 비어 있을 때만 쓰인다
# QA_ADMIN_USERNAME=admin
# QA_ADMIN_PASSWORD=

# QA_LOG_LEVEL=info
# QA_AUDIT_RETENTION_DAYS=365
