{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["QA_IT_*", "DOCKER_HOST", "TESTCONTAINERS_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@qa/api#build": {
      "dependsOn": ["^build", "@qa/web#build"],
      "outputs": ["dist/**", "public/**"]
    }
  }
}
