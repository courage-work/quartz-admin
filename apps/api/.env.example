# 로컬 개발용 환경변수 예시. `cp .env.example .env` 후 값을 채운다 (.env는 git에 올리지 않음)
# 전체 목록과 기본값은 docs/TRD.md §11.2 참고

# 필수: 암호화 키. `pnpm --filter @qa/api build && pnpm --filter @qa/api cli gen-key` 출력값을 넣는다
QA_ENCRYPTION_KEYS=
QA_ENCRYPTION_ACTIVE_KEY=k1

# 필수: 브라우저가 접속하는 주소 (Origin 검사, 알림 링크)
# http://면 세션 쿠키의 Secure를 끈다. 운영에서는 https:// 주소를 쓴다
# 웹 개발 서버(pnpm --filter @qa/web dev)로 화면을 보면 그 주소(3001)를, 빌드한 API로 보면 3000을 쓴다
# 한 프로세스 개발 모드(pnpm dev:hmr)는 이 값 대신 http://localhost:<PORT>(기본 3000)를 쓴다
QA_PUBLIC_URL=http://localhost:3001

# 개발 서버는 apps/api/data/에 SQLite를 둔다 (.gitignore 대상)
QA_DATA_DIR=./data

# 최초 기동 시 관리자 계정. users 테이블이 비어 있을 때만 쓰인다
# 아이디는 영문 소문자·숫자·._@- 3~64자, 비밀번호는 8자 이상
# QA_ADMIN_USERNAME=admin
# QA_ADMIN_PASSWORD=
