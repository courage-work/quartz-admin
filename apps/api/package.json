{
  "name": "@qa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle",
    "public"
  ],
  "scripts": {
    "build": "nest build && node scripts/copy-web.mjs",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "dev:hmr": "node scripts/dev-hmr.mjs",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "cli": "node --env-file-if-exists=.env dist/cli.js",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@node-rs/argon2": "catalog:",
    "@qa/core": "workspace:*",
    "@qa/shared": "workspace:*",
    "@qa/store": "workspace:*",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:",
    "helmet": "catalog:",
    "nestjs-pino": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/core": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
